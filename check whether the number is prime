#include <stdio.h>

int main(void) {
    int n, a = 0;
    scanf("%d", &n);  // input is read for you

    // Write your code below. Print: <n> is Prime or <n> is Not Prime
    for (int i = 1; i <= n; i++)
    {
        if (n % i == 0) {
            a++;
        }
    }
    if (a == 2)
        printf("%d is Prime", n);
    else
        printf("%d is Not Prime", n);

    return 0;
}
